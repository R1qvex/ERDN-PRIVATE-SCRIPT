local function startFastRep(repsPerSecond)
    if repsPerSecond>1000 then repsPerSecond=1000 end
    if repsPerSecond<1 then repsPerSecond=1 end
    if not State.FastRep then
        local stats=getPlayerStats()
        StatsTracker.LastStr=stats.Str;StatsTracker.TotalStr=0;StatsTracker.TotalDur=0
        StatsTracker.FastRepStartTime=tick();StatsTracker.SnapStr=0;StatsTracker.SnapDur=0;StatsTracker.SnapTime=tick()
    end
    stopFastRep()
    State.FastRep=true
    fastRepThread=task.spawn(function()
        local cachedEvent=player:FindFirstChild("muscleEvent")or player:FindFirstChild("MuscleEvent")
        local accumulatedReps=0
        local lastTime=tick()
        while State.FastRep do
            if not cachedEvent or not cachedEvent.Parent then
                cachedEvent=player:FindFirstChild("muscleEvent")or player:FindFirstChild("MuscleEvent")
            end
            if cachedEvent then
                local currentTime=tick()
                local deltaTime=currentTime-lastTime
                lastTime=currentTime
                accumulatedReps=accumulatedReps+(repsPerSecond*deltaTime)
                local repsToSend=math.floor(accumulatedReps)
                if repsToSend>0 then
                    accumulatedReps=accumulatedReps-repsToSend
                    local fireServer=cachedEvent.FireServer
                    local totalSent=0
                    while totalSent<repsToSend do
                        local batchSize=math.random(35,65)
                        local toSend=math.min(batchSize,repsToSend-totalSent)
                        for i=1,toSend do pcall(fireServer,cachedEvent,"rep")end
                        totalSent=totalSent+toSend
                        if totalSent<repsToSend then task.wait(jitter(0.005,0.003))end
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

