                        bossWasAlive=false
                        lastAlienBoss=nil
                        lastPetReequip=tick()
                        pcall(function()equipBossDamagePets(nil)end)
                        if getgenv().AlienStatusLbl then updatePara(getgenv().AlienStatusLbl,"Waiting for boss...")end
                    else
                        if getgenv().AlienStatusLbl then updatePara(getgenv().AlienStatusLbl,"Waiting for boss...")end
                    end
                end
            end)
            if hasTarget then
                task.wait(jitter(0.05,0.01))
