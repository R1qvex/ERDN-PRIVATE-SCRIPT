        local isAlive = true
        if target.healthValue then isAlive = target.healthValue.Value > 0; State.BossHealth = tostring(target.healthValue.Value) end
        if isAlive then
            State.CurrentBoss = model.Name
            local hrp = getHRP()
            if hrp and model then
                pcall(function()
                    hrp.Anchored = false; hrp.Velocity = Vector3.zero
                    local centerPos = model:GetPivot().Position
                    if model ~= BossCache.Model or tick() - BossCache.LastCheck > 1 then
                        BossCache.Model = model; BossCache.LastCheck = tick(); BossCache.TopY = -math.huge
