            for _,v in ipairs(Workspace:GetDescendants()) do 
                if v.Name == "BossArena" and v:IsA("Folder") then BossCache.Arena = v; break end 
            end 
        end
    end
    if BossCache.Arena then
        for _,obj in ipairs(BossCache.Arena:GetChildren()) do
