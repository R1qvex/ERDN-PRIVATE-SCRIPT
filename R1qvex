local BOSS_DAMAGE_ATTR_HINTS={"bossdamage","bossdmg","bossmultiplier","bosspower","bossbonus","damagetoboss","bossdamageboost","bossdamagemultiplier","bossdamagepercent","bossdmgmultiplier","bossdamagepassive","bossbust"}
local function getPetBossDamageAmount(pet)
    if not pet then return 0 end
    local best=0
    local ok,attrs=pcall(function()return pet:GetAttributes()end)
    if ok and type(attrs)=="table"then
        for name,value in pairs(attrs)do
            if type(value)=="number"then
                local lower=string.lower(name)
                if string.find(lower,"boss")then
                    for _,hint in ipairs(BOSS_DAMAGE_ATTR_HINTS)do
                        if string.find(lower,hint)then
                            if value>best then best=value end
                            break
                        end
                    end
                end
            end
        end
    end
    for _,desc in ipairs(pet:GetDescendants())do
        if desc:IsA("ValueBase")and type(desc.Value)=="number"then
            local lower=string.lower(desc.Name)
            if string.find(lower,"boss")then
                for _,hint in ipairs(BOSS_DAMAGE_ATTR_HINTS)do
                    if string.find(lower,hint)then
                        if desc.Value>best then best=desc.Value end
                        break
                    end
                end
            end
        end
    end
    return best
end
local function hasBossDamagePassive(pet)
    if not pet then return false end
    if getPetBossDamageAmount(pet)>0 then return true end
    local lowerName=string.lower(pet.Name)
    if string.find(lowerName,"boss")then return true end
    local ok,attrs=pcall(function()return pet:GetAttributes()end)
    if ok and type(attrs)=="table"then
        for name,value in pairs(attrs)do
            local lower=string.lower(name)
            if string.find(lower,"boss")and(value==true or(type(value)=="number"and value>0))then
                return true
            end
        end
    end
    return false
end

local isEquippingPets=false
local autoAlienPetConn=nil
local lastPetEventTrigger=0

local function equipBossDamagePets(isCurrent)
    if isCurrent and not isCurrent() then return end
    if isEquippingPets then return end
    isEquippingPets=true
    pcall(function()
        local petsFolder=player:FindFirstChild("petsFolder")
        if not petsFolder then return end
        local candidates={}
        for _,folder in ipairs(petsFolder:GetChildren())do
            if folder:IsA("Folder")then
                for _,pet in ipairs(folder:GetChildren())do
                    local config=PETS[pet.Name] or {repSpeed=0,strength=0,durability=0,rebirth=0}
                    local bossDmg=getPetBossDamageAmount(pet)
                    local hasPassive=hasBossDamagePassive(pet)
                    local score
                    if hasPassive then
                        score=1000000+(bossDmg*10000)+(config.strength*100)+(config.durability*10)+config.repSpeed
                    else
                        score=(config.strength*100)+(config.durability*10)+config.repSpeed
                    end
                    table.insert(candidates,{instance=pet,score=score,hasPassive=hasPassive,bossDmg=bossDmg})
                end
            end
        end
        table.sort(candidates,function(a,b)return a.score>b.score end)
        local selected={}
        local count=0
        for _,c in ipairs(candidates)do
            if count>=MAX_PET_SLOTS then break end
            if c.hasPassive or c.score>0 then
                table.insert(selected,c.instance)
                count=count+1
            end
        end
        if count==0 then
            for _,c in ipairs(candidates)do
                if count>=MAX_PET_SLOTS then break end
                table.insert(selected,c.instance)
                count=count+1
            end
        end
        applyPetLoadout(selected,isCurrent)
    end)
    task.delay(2,function()isEquippingPets=false end)
end

