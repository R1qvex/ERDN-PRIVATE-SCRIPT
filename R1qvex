local function bossAttackOnce(model,hitbox)
    if not model or not model.Parent then return end
    local character=getChar()
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health<=0 then return end
    if not hitbox or not hitbox.Parent then return end
    local backpack=player:FindFirstChild("Backpack")
    local punchInChar=character:FindFirstChild("Punch")
    local punchInBag=backpack and backpack:FindFirstChild("Punch")
    local punch=punchInChar or punchInBag
    if punchInBag and not punchInChar then
        pcall(function()humanoid:EquipTool(punchInBag)end)
    end
    local bossRoot=model:FindFirstChild("BossDamageHitbox",true)
        or model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart",true)
    if not bossRoot then return end
    local targetPos=hitbox.Position+Vector3.new(0,hitbox.Size.Y*0.5+3,0)
    if targetPos.Magnitude==0 or targetPos~=targetPos then
        targetPos=bossRoot.Position+Vector3.new(0,5,0)
    end
    root.CFrame=CFrame.lookAt(targetPos,hitbox.Position)
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    local leftHand=character:FindFirstChild("LeftHand")
    local rightHand=character:FindFirstChild("RightHand")
    if leftHand and rightHand then
        pcall(function()
            firetouchinterest(hitbox,rightHand,0);firetouchinterest(hitbox,rightHand,1)
            firetouchinterest(hitbox,leftHand,0);firetouchinterest(hitbox,leftHand,1)
        end)
        for _,part in ipairs(model:GetDescendants())do
            if part:IsA("BasePart")and part.CanTouch and part~=hitbox then
                pcall(function()
                    firetouchinterest(part,rightHand,0);firetouchinterest(part,rightHand,1)
                    firetouchinterest(part,leftHand,0);firetouchinterest(part,leftHand,1)
                end)
            end
        end
    end
    local ev=player:FindFirstChild("muscleEvent")or player:FindFirstChild("MuscleEvent")
    if ev then
        pcall(function()
            ev:FireServer("punch","leftHand")
            ev:FireServer("punch","rightHand")
        end)
    end
    if punch and punch.Parent==character then
        pcall(function()punch:Activate()end)
    end
end

