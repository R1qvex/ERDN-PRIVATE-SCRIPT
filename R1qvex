local bossHeartbeatConn = nil
local function getBossTargets()
    local bosses = {}; local myChar = getChar()
    local targetNames = {["Boss1"]=true,["Boss2"]=true,["Boss3"]=true,["Boss4"]=true,["Boss5"]=true,["Boss6"]=true}
    
    if not BossCache.Arena or not BossCache.Arena.Parent then
        local events = Workspace:FindFirstChild("Events")
        BossCache.Arena = events and events:FindFirstChild("BossArena")
        if not BossCache.Arena then 
            for _,v in ipairs(Workspace:GetDescendants()) do 
                if v.Name=="BossArena" and v:IsA("Folder") then BossCache.Arena=v; break end 
            end 
        end
    end
    
    if BossCache.Arena then
        for _,obj in ipairs(BossCache.Arena:GetChildren()) do
            if obj:IsA("Model") and obj~=myChar and targetNames[obj.Name] then
                local hpVal = nil
                for _,v in ipairs(obj:GetDescendants()) do
                    if (v:IsA("NumberValue") or v:IsA("IntValue")) and (string.find(string.lower(v.Name),"health") or string.find(string.lower(v.Name),"hp") or v.Name=="Value") then hpVal=v; break end
                end
                table.insert(bosses,{model=obj, healthValue=hpVal})
            end
        end
    end
    return bosses
end

local function startAutoFarmBoss()
    if State.AutoFarmBoss then return end; State.AutoFarmBoss = true
    State.AutoPunch = false; stopAutoPunch(); startAutoPunch()
    if bossHeartbeatConn then bossHeartbeatConn:Disconnect() end
    BossCache.Model = nil
    BossCache.TopY = 0
    
    bossHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not State.AutoFarmBoss then return end
        local bosses = getBossTargets()
        if #bosses == 0 then State.CurrentBoss = "Waiting..."; State.BossHealth = "N/A"; return end
        local target = bosses[1]; local model = target.model
        local isAlive = true
        if target.healthValue then isAlive = target.healthValue.Value > 0; State.BossHealth = tostring(target.healthValue.Value) end
        if isAlive then
            State.CurrentBoss = model.Name
            local hrp = getHRP()
            if hrp and model then
                pcall(function()
                    hrp.Anchored = false; hrp.Velocity = Vector3.zero
                    local centerPos = model:GetPivot().Position
                    if model ~= BossCache.Model or tick() - BossCache.LastCheck > 1 then
                        BossCache.Model = model
                        BossCache.LastCheck = tick()
                        BossCache.TopY = -math.huge
                        for _,v in ipairs(model:GetDescendants()) do
                            if v:IsA("BasePart") and v.Transparency < 0.9 then
                                local topEdge = v.Position.Y + (v.Size.Y / 2)
                                if topEdge > BossCache.TopY then BossCache.TopY = topEdge end
                            end
                        end
                        if BossCache.TopY == -math.huge then BossCache.TopY = centerPos.Y end
                    end
                    hrp.CFrame = CFrame.lookAt(Vector3.new(centerPos.X, BossCache.TopY + 2.5, centerPos.Z), centerPos)
                end)
            end
        end
    end)
end

local function stopAutoFarmBoss()
    State.AutoFarmBoss = false
    if bossHeartbeatConn then bossHeartbeatConn:Disconnect(); bossHeartbeatConn = nil end
    stopAutoPunch(); local hrp = getHRP(); if hrp then pcall(function() hrp.Anchored = false end) end
end

