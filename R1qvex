local function findAlienHpVar()
    if alienHpVarCache and alienHpVarCache.Parent then return alienHpVarCache end
    local now=tick()
    if not alienBossWakeup and now-alienHpVarLastScan<alienHpVarScanInterval then return nil end
    alienHpVarLastScan=now
    alienHpVarCache=workspace:FindFirstChild("alienBossHealth",true)
    return alienHpVarCache
end

local function markAlienBossDead(boss)
    if boss then deadAlienBosses[boss]=true end
    alienBossCache=nil
    alienHpVarCache=nil
    alienHpVarLastScan=0
end

local function isAlienBossDead(model)
    if not model or not model.Parent then return true end
    if deadAlienBosses[model] then return true end
    local hpVar=model:FindFirstChild("alienBossHealth",true)
    if hpVar and hpVar:IsA("ValueBase")then
        if hpVar.Value<=0 then deadAlienBosses[model]=true return true end
        return false
    end
    local hum=model:FindFirstChildWhichIsA("Humanoid",true)
    if hum then
        if hum.Health<=0 then deadAlienBosses[model]=true return true end
        local ok,state=pcall(function()return hum:GetState()end)
        if ok and state==Enum.HumanoidStateType.Dead then deadAlienBosses[model]=true return true end
        return false
    end
    for _,attrName in ipairs({"Dead","IsDead","Killed","Defeated","IsKilled"})do
        if model:GetAttribute(attrName)==true then deadAlienBosses[model]=true return true end
    end
    if CollectionService:HasTag(model,"Dead")or CollectionService:HasTag(model,"Ragdoll")or CollectionService:HasTag(model,"Corpse")then
        deadAlienBosses[model]=true return true
    end
    local nameLower=string.lower(model.Name)
    if string.find(nameLower,"dead")or string.find(nameLower,"ragdoll")or string.find(nameLower,"corpse")then
        deadAlienBosses[model]=true return true
    end
    local anyHpVar=findAlienHpVar()
    if not anyHpVar then deadAlienBosses[model]=true return true end
    local hpModel=anyHpVar:FindFirstAncestorOfClass("Model")
    if hpModel and hpModel~=model then deadAlienBosses[model]=true return true end
    return false
end

local function getAlienBoss()
    if alienBossCache and alienBossCache.Parent then
        if not isAlienBossDead(alienBossCache)then return alienBossCache end
        alienBossCache=nil
    end
    local b1=workspace:FindFirstChild("Alien Boss")
    if b1 and b1:IsA("Model")and not isAlienBossDead(b1)then
        alienBossCache=b1
        return b1
    end
    local hpVar=findAlienHpVar()
    if hpVar and hpVar:IsA("ValueBase")and hpVar.Value>0 then
        local model=hpVar:FindFirstAncestorOfClass("Model")
        if model and not isAlienBossDead(model)then
            alienBossCache=model
            return model
        end
    end
    local now=tick()
    if not alienBossWakeup and now-alienBossLastScan<alienBossScanInterval then return nil end
    alienBossWakeup=false
    alienBossLastScan=now
    for _,v in ipairs(workspace:GetDescendants())do
        if v:IsA("Model")then
            local name=string.lower(v.Name)
            if(string.find(name,"alien boss")or string.find(name,"alienboss"))and not string.find(name,"arena")then
                if not isAlienBossDead(v)then
                    alienBossCache=v
                    return v
                end
            end
        end
    end
    return nil
end

local function claimChest(chest)
    local char=getChar()
    local hrp=getHRP()
    if not char or not hrp or not chest or not chest.Parent then return false end
    local chestPart=chest:IsA("BasePart")and chest or chest:FindFirstChildWhichIsA("BasePart",true)
    if not chestPart then return false end
    pcall(function()
        hrp.AssemblyLinearVelocity=Vector3.zero
        hrp.AssemblyAngularVelocity=Vector3.zero
        hrp.Anchored=true
        hrp.CFrame=CFrame.new(chestPart.Position+Vector3.new(0,3,4))
    end)
    task.wait(0.3)
    pcall(function()
        hrp.Anchored=false
        hrp.AssemblyLinearVelocity=Vector3.zero
        hrp.AssemblyAngularVelocity=Vector3.zero
    end)
    local settleStart=tick()
    while tick()-settleStart<0.5 do
        local vel=hrp.AssemblyLinearVelocity.Magnitude
        if vel<3 then break end
        pcall(function()
            hrp.AssemblyLinearVelocity=Vector3.zero
            hrp.AssemblyAngularVelocity=Vector3.zero
        end)
        task.wait(0.05)
    end
    local prompt=chest:FindFirstChildWhichIsA("ProximityPrompt",true)
    local click=chest:FindFirstChildWhichIsA("ClickDetector",true)
    if prompt then
        local oldDist=prompt.MaxActivationDistance
        prompt.MaxActivationDistance=999999
        pcall(fireproximityprompt,prompt)
        prompt.MaxActivationDistance=oldDist
    elseif click then
        pcall(fireclickdetector,click)
    else
        pcall(function()
            firetouchinterest(chestPart,hrp,0)
            firetouchinterest(chestPart,hrp,1)
        end)
    end
    return true
end

