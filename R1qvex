local function formatNumber(n)
    if not n or n == 0 or n ~= n or n == math.huge or n == -math.huge then return "0" end
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
    local i = math.floor(math.log(n, 1000))
    if i < 1 then return tostring(math.floor(n)) end
    local val = n / math.pow(1000, i)
    return string.format("%.2f%s", val, suffixes[i + 1] or "")
end

local durObj = nil
local function readDurability()
    if not (durObj and durObj.Parent) then
        durObj = nil
        local leaderstats = player:FindFirstChild("leaderstats")
        local holders = {player}
        if leaderstats then table.insert(holders, leaderstats) end
        for _, name in ipairs({"Durability", "Defense"}) do
            for _, holder in ipairs(holders) do
                local v = holder:FindFirstChild(name)
                if v and v:IsA("ValueBase") and type(v.Value) == "number" then
                    durObj = v; break
                end
            end
            if durObj then break end
        end
    end
    if durObj then return durObj.Value, durObj end
    local hooked = getgenv().RealDurability or 0
    if hooked > 0 then return hooked, "hook" end
    return 0, nil
end

local function getPlayerStats()
    local stats = {Str = 0, Dur = 0, Reb = 0, DurSource = nil}
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local str = leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Power")
        local reb = leaderstats:FindFirstChild("Rebirths")
        if str then stats.Str = str.Value end
        if reb then stats.Reb = reb.Value end
    end
    stats.Dur, stats.DurSource = readDurability()
    return stats
end

--==================== AUTO RACE LOGIC ====================
local function getZone(hrp, char)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(hrp.Position - Vector3.new(0, 5, 0), Vector3.new(0, -25, 0), params)
    if result then
        local color = result.Instance.Color
        for zoneName, zoneColor in pairs(ZoneColors) do
            if (color.R - zoneColor.R)^2 + (color.G - zoneColor.G)^2 + (color.B - zoneColor.B)^2 < 0.1 then
                return zoneName
            end
        end
    end
    return "Unknown"
end

local function startAutoRace()
    if State.AutoRace then return end
    State.AutoRace = true
    forwardDir = nil
    isFinished = false
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hum then
        originalSpeed = hum.WalkSpeed
        if originalSpeed <= 0 then originalSpeed = 16 end 
    end
    
    task.spawn(function()
        while State.AutoRace do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                hum.PlatformStand = false
                if hum.Sit then hum.Sit = false end
                hum.WalkSpeed = originalSpeed
                
                local rx, ry, rz = hrp.CFrame:ToEulerAnglesYXZ()
                if math.abs(rx) > 0.2 or math.abs(rz) > 0.2 then
                    hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, ry, 0)
                end
                hrp.AssemblyAngularVelocity = Vector3.zero
                
                if (hrp.Position - SPAWN_POS).Magnitude < 50 and tick() - lastTeleportTime > 3 then
                    lastTeleportTime = tick()
                    hrp.CFrame = CFrame.new(NEW_START_POS)
                    isFinished = false
                    hum.WalkSpeed = originalSpeed 
                    task.wait(1)
                end
                
                local zone = getZone(hrp, char)
                if RaceStatusLabel then RaceStatusLabel.Text = "ZONE: " .. string.upper(zone) end
                
                if not forwardDir and (zone == "Yellow" or zone == "Blue" or zone == "Green") then
                    local look = hrp.CFrame.LookVector
                    forwardDir = Vector3.new(look.X, 0, look.Z).Unit
                end
                
                local distToEnd = (hrp.Position - FINISH_POS).Magnitude
                
                if isFinished then
                    hum.WalkSpeed = 0
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                elseif zone == "Green" or distToEnd < 150 then
                    if distToEnd > 5 then
                        hum.WalkSpeed = originalSpeed
                        local targetVel = (FINISH_POS - hrp.Position).Unit * originalSpeed
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVel.X, hrp.AssemblyLinearVelocity.Y, targetVel.Z)
                    else
                        isFinished = true
                        hum.WalkSpeed = 0
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                elseif zone == "Yellow" or zone == "Blue" then
                    if forwardDir then
                        local targetVel = forwardDir * originalSpeed
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVel.X, hrp.AssemblyLinearVelocity.Y, targetVel.Z)
                    end
                elseif zone == "Purple" or zone == "Red" then
                    hum.WalkSpeed = originalSpeed
                    hum:MoveTo(hrp.Position) 
                else
                    if forwardDir then
                        local targetVel = forwardDir * originalSpeed
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVel.X, hrp.AssemblyLinearVelocity.Y, targetVel.Z)
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

