--==================== AUTO FARM BOSS (MECÁNICA ORIGINAL) ====================
local function getBossTargets()
    local bosses = {}
    local myChar = getChar()
    local targetNames = {["Boss1"]=true,["Boss2"]=true,["Boss3"]=true,["Boss4"]=true,["Boss5"]=true,["Boss6"]=true}
    local events = Workspace:FindFirstChild("Events")
    local bossArena = events and events:FindFirstChild("BossArena")
    if not bossArena then
        for _,v in ipairs(Workspace:GetDescendants()) do if v.Name=="BossArena" and v:IsA("Folder") then bossArena=v; break end end
    end
    if bossArena then
        for _,obj in ipairs(bossArena:GetChildren()) do
            if obj:IsA("Model") and obj~=myChar and targetNames[obj.Name] then
                local hpVal = nil
                for _,v in ipairs(obj:GetDescendants()) do
                    if (v:IsA("NumberValue") or v:IsA("IntValue")) and (string.find(string.lower(v.Name),"health") or string.find(string.lower(v.Name),"hp") or v.Name=="Value") then hpVal=v; break end
                end
                table.insert(bosses,{model=obj, healthValue=hpVal})
            end
        end
    end
    return bosses
end

local function startAutoFarmBoss()
    if State.AutoFarmBoss then return end
    State.AutoFarmBoss = true
    State.AutoPunch = false; stopAutoPunch(); startAutoPunch()
    local heartbeatConn = nil
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not State.AutoFarmBoss then if heartbeatConn then heartbeatConn:Disconnect() end; local hrp=getHRP(); if hrp then pcall(function() hrp.Anchored=false end) end; return end
        local bosses = getBossTargets()
        if #bosses == 0 then return end
        local target = bosses[1]; local model = target.model
        local isAlive = true
        if target.healthValue then isAlive = target.healthValue.Value > 0 end
        if isAlive then
            local hrp = getHRP()
            if hrp and model then
                pcall(function()
                    hrp.Anchored = false; hrp.Velocity = Vector3.zero
                    local centerPos = model:GetPivot().Position; local highestY = -math.huge
                    for _,v in ipairs(model:GetDescendants()) do
                        if v:IsA("BasePart") and v.Transparency < 0.9 then
                            local topEdge = v.Position.Y + (v.Size.Y / 2)
                            if topEdge > highestY then highestY = topEdge end
                        end
                    end
                    if highestY == -math.huge then highestY = centerPos.Y end
                    local newPos = Vector3.new(centerPos.X, highestY + 2.5, centerPos.Z)
                    hrp.CFrame = CFrame.lookAt(newPos, centerPos)
                end)
            end
        end
    end)
end

