        knob.BackgroundColor3 = Colors.textDim
        knob.Parent = toggle
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local state = false
        local toggleObj = {
            set = function(newState, invoke)
                state = newState
                TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3 = state and Colors.accent or Colors.bg}):Play()
                TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = state and Colors.white or Colors.textDim}):Play()
                if invoke and callback then callback(state) end
            end
        }
        toggle.MouseButton1Click:Connect(function() toggleObj.set(not state, true); createSparkle(frame, UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) end)
        return toggleObj
    end

