    local tabs = {
        {name = "Farm", icon = "🎃"},
        {name = "Recursos", icon = "💎"},
        {name = "Combate", icon = "⚔️"},
        {name = "Utilidades", icon = "🦇"},
    }

    for _, tab in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -20, 0, 40)
        btn.BackgroundColor3 = Colors.panel
        btn.BackgroundTransparency = 0.5
        btn.BorderSizePixel = 0
        btn.Text = "  " .. tab.icon .. "  " .. tab.name
        btn.TextColor3 = Colors.text
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = sidebar
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -20, 1, -20)
        page.Position = UDim2.new(0, 10, 0, 10)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Visible = false
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Parent = content
        pages[tab.name] = page

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = page

        btn.MouseButton1Click:Connect(function()
            switchTab(tab.name)
            for _, b in ipairs(sidebar:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = (b == btn) and Colors.accent or Colors.panel
                    b.TextColor3 = (b == btn) and Colors.bg or Colors.text
                end
            end
        end)
    end

    local function createToggle(parent, text, callback)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, -10, 0, 52)
        frame.BackgroundColor3 = Colors.sidebar
        frame.BorderSizePixel = 0
        frame.Parent = parent
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -60, 1, 0)
        label.Position = UDim2.new(0, 14, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Colors.text
        label.TextSize = 12
        label.Font = Enum.Font.GothamBold
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame

        local toggle = Instance.new("TextButton")
        toggle.Size = UDim2.new(0, 44, 0, 24)
        toggle.Position = UDim2.new(1, -56, 0.5, -12)
        toggle.BackgroundColor3 = Colors.bg
        toggle.Text = ""
        toggle.Parent = frame
        Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 18, 0, 18)
        knob.Position = UDim2.new(0, 3, 0.5, -9)
        knob.BackgroundColor3 = Colors.textDim
        knob.Parent = toggle
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local state = false
        local toggleObj = {
            set = function(newState, invoke)
                state = newState
                TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3 = state and Colors.accent or Colors.bg}):Play()
                TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9), BackgroundColor3 = state and Colors.white or Colors.textDim}):Play()
                if invoke and callback then callback(state) end
            end
        }
        toggle.MouseButton1Click:Connect(function() toggleObj.set(not state, true); createSparkle(frame, UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) end)
        return toggleObj
    end

    -- Pestaña Farm
    local farmPage = pages["Farm"]
    createToggle(farmPage, "Ultra Fast Rep (10k/s)", function(v) if v then startFastRep(10000) else stopFastRep() end end)
    createToggle(farmPage, "Auto Punch", function(v) if v then startAutoPunch() else stopAutoPunch() end end)
    createToggle(farmPage, "Auto Farm Strength", function(v) State.AutoFarmStrength = v; if v then startAutoFarmStrength() end end)
    createToggle(farmPage, "Auto Rebirth", function(v) State.AutoRebirth = v; if v then startAutoRebirth() end end)
    createToggle(farmPage, "Auto Treadmill", function(v) State.AutoTreadmill = v end)
    createToggle(farmPage, "Auto Farm Boss", function(v) State.AutoFarmBoss = v; if v then startAutoFarmBoss() else stopAutoPunch() end end)

    -- Pestaña Recursos
    local resourcePage = pages["Recursos"]
    createToggle(resourcePage, "Auto Hatch Eggs", function(v) State.AutoHatch = v; if v then startAutoHatch() end end)
    createToggle(resourcePage, "Auto Equip Best Pets", function(v) State.AutoEquipBestPets = v; if v then startAutoEquipBestPets() end end)
    createToggle(resourcePage, "Auto Buy Ultimates", function(v) State.AutoBuyUltimates = v end)
    createToggle(resourcePage, "Auto Buy Auras", function(v) State.AutoBuyAuras = v end)
    createToggle(resourcePage, "Auto Claim Chests", function(v) State.AutoClaimChests = v end)
    createToggle(resourcePage, "Auto Fortune Wheel", function(v) State.AutoFortuneWheel = v end)

    -- Pestaña Combate
    local combatPage = pages["Combate"]
    createToggle(combatPage, "Kill Aura", function(v) State.KillAura = v; if v then startKillAura() end end)
    createToggle(combatPage, "Auto Join Brawl", function(v) State.AutoJoinBrawl = v end)
    createToggle(combatPage, "Auto Win Brawl", function(v) State.AutoWinBrawl = v end)

    -- Pestaña Utilidades
    local utilPage = pages["Utilidades"]
    createToggle(utilPage, "ESP (Players)", function(v) State.ESP = v; toggleESP(v) end)
    createToggle(utilPage, "Noclip", function(v) State.Noclip = v end)
    createToggle(utilPage, "Fly (WASD)", function(v) toggleFly(v) end)
    createToggle(utilPage, "Anti-Fling", function(v) State.AntiFling = v end)
    createToggle(utilPage, "Anti-Knockback", function(v) State.AntiKnockback = v end)
    createToggle(utilPage, "Walk on Water", function(v) State.WalkOnWater = v end)
    createToggle(utilPage, "Anti-AFK", function(v) toggleAntiAfk(v) end)
    createToggle(utilPage, "FPS Boost", function(v) toggleFPSBoost(v) end)

    switchTab("Farm")

    local minimized = false
    local floatBtn = nil
    local function minimize()
        if minimized then return end
        minimized = true
        main.Visible = false
        floatBtn = Instance.new("TextButton")
        floatBtn.Size = UDim2.new(0, 54, 0, 54)
        floatBtn.Position = UDim2.new(0, 20, 0.5, -27)
        floatBtn.BackgroundColor3 = Colors.accent
        floatBtn.Text = "🎃"
        floatBtn.TextSize = 24
        floatBtn.Font = Enum.Font.GothamBold
        floatBtn.TextColor3 = Colors.bg
        floatBtn.Parent = screenGui
        Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(1, 0)
        floatBtn.MouseButton1Click:Connect(function()
            minimized = false
            floatBtn:Destroy()
            main.Visible = true
        end)
    end
    minimizeBtn.MouseButton1Click:Connect(minimize)
end

verifyBtn.MouseButton1Click:Connect(function()
    if keyInput.Text == KEY then
        playSplashAnimation(buildMainUI)
    else
        keyInput.Text = ""
        keyInput.PlaceholderText = "Invalid Private Key"
        keyInput.PlaceholderColor3 = Colors.danger
    end
end)
