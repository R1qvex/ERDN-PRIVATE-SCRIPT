    -- Stats Loop
    task.spawn(function()
        while sg.Parent do
            local stats = getPlayerStats()
            if State.FastRep then
                if stats.Str > StatsTracker.LastStr then
                    StatsTracker.TotalStr = StatsTracker.TotalStr + (stats.Str - StatsTracker.LastStr)
                end
                StatsTracker.LastStr = stats.Str
                
                if StatsTracker.DurSession ~= StatsTracker.FastRepStartTime then
                    StatsTracker.DurSession = StatsTracker.FastRepStartTime
                    StatsTracker.LastDur = nil
                    StatsTracker.DurSource = nil
                end
                if stats.Dur > 0 then
                    if stats.DurSource ~= StatsTracker.DurSource or StatsTracker.LastDur == nil then
                        StatsTracker.DurSource = stats.DurSource
                        StatsTracker.LastDur = stats.Dur
                    else
                        if stats.Dur > StatsTracker.LastDur then
                            StatsTracker.TotalDur = StatsTracker.TotalDur + (stats.Dur - StatsTracker.LastDur)
                        end
                        StatsTracker.LastDur = stats.Dur
                    end
                end
                
                local strDurElapsed = tick() - StatsTracker.SnapTime
                local overallElapsed = tick() - StatsTracker.FastRepStartTime
                strDurTimerTitle.Text = string.format("Rep Time: %02dd %02dh %02dm %02ds", math.floor(overallElapsed / 86400), math.floor((overallElapsed % 86400) / 3600), math.floor((overallElapsed % 3600) / 60), math.floor(overallElapsed % 60))
                
                if strDurElapsed >= 10 then
                    strDurTimerStatus.Text = "Updated! (10s)"
                    strDurTimerStatus.TextColor3 = Colors.accent
                    local diffStr = StatsTracker.TotalStr - StatsTracker.SnapStr
                    local diffDur = StatsTracker.TotalDur - StatsTracker.SnapDur
                    local strPerSec = diffStr / strDurElapsed
                    local durPerSec = diffDur / strDurElapsed
                    for i, mult in ipairs({1, 60, 3600, 86400, 604800}) do
                        strLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": " .. formatNumber(strPerSec * mult)
                        durLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": " .. formatNumber(durPerSec * mult)
                    end
                    StatsTracker.SnapStr = StatsTracker.TotalStr
                    StatsTracker.SnapDur = StatsTracker.TotalDur
                    StatsTracker.SnapTime = tick()
                else
                    strDurTimerStatus.Text = "Calculating in " .. string.format("%.0f", 10 - strDurElapsed) .. "s..."
                    strDurTimerStatus.TextColor3 = Colors.textDim
                end
            else
                StatsTracker.TotalStr = 0
                StatsTracker.TotalDur = 0
                strDurTimerTitle.Text = "Rep Time: 00:00:00"
                strDurTimerStatus.Text = "Inactive"
                strDurTimerStatus.TextColor3 = Colors.danger
                for i = 1, 5 do
                    strLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": 0"
                    durLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": 0"
                end
            end
            
            if State.AutoRebirth then
                if stats.Reb > StatsTracker.LastReb then
                    StatsTracker.TotalReb = StatsTracker.TotalReb + (stats.Reb - StatsTracker.LastReb)
                end
                StatsTracker.LastReb = stats.Reb
                local rebElapsed = tick() - StatsTracker.RebSnapTime
                local overallRebElapsed = tick() - StatsTracker.RebStartTime
                rebTimerTitle.Text = string.format("Reb Time: %02dd %02dh %02dm %02ds", math.floor(overallRebElapsed / 86400), math.floor((overallRebElapsed % 86400) / 3600), math.floor((overallRebElapsed % 3600) / 60), math.floor(overallRebElapsed % 60))
                if rebElapsed >= 60 then
                    rebTimerStatus.Text = "Updated! (60s)"
                    rebTimerStatus.TextColor3 = Colors.accent
                    local diffReb = StatsTracker.TotalReb - StatsTracker.SnapReb
                    local rebPerSec = diffReb / rebElapsed
                    for i, mult in ipairs({1, 60, 3600, 86400, 604800}) do
                        rebLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": " .. formatNumber(rebPerSec * mult)
                    end
                    StatsTracker.SnapReb = StatsTracker.TotalReb
                    StatsTracker.RebSnapTime = tick()
                else
                    rebTimerStatus.Text = "Calculating in " .. string.format("%.0f", 60 - rebElapsed) .. "s..."
                    rebTimerStatus.TextColor3 = Colors.textDim
                end
            else
                StatsTracker.TotalReb = 0
                rebTimerTitle.Text = "Reb Time: 00:00:00"
                rebTimerStatus.Text = "Inactive"
                rebTimerStatus.TextColor3 = Colors.danger
                for i = 1, 5 do rebLabels[i].Text = "/ " .. ({"sec", "min", "hour", "day", "week"})[i] .. ": 0" end
            end

            totalStrLabel.Text = "Str: " .. formatNumber(StatsTracker.TotalStr)
            totalDurLabel.Text = "Dur: " .. formatNumber(StatsTracker.TotalDur)
            totalRebLabel.Text = "Reb: " .. formatNumber(StatsTracker.TotalReb)
            
            task.wait(0.1)
        end
    end)

