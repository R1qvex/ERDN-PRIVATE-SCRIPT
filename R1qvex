local function formatNumber(n)
    if not n or n == 0 or n ~= n or n == math.huge or n == -math.huge then return "0" end
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
    local i = math.floor(math.log(n, 1000))
    if i < 1 then return tostring(math.floor(n)) end
    local val = n / math.pow(1000, i)
    return string.format("%.2f%s", val, suffixes[i + 1] or "")
end

local durObj = nil
local function readDurability()
    if not (durObj and durObj.Parent) then
        durObj = nil
        local leaderstats = player:FindFirstChild("leaderstats")
        local holders = {player}
        if leaderstats then table.insert(holders, leaderstats) end
        for _, name in ipairs({"Durability", "Defense"}) do
            for _, holder in ipairs(holders) do
                local v = holder:FindFirstChild(name)
                if v and v:IsA("ValueBase") and type(v.Value) == "number" then
                    durObj = v; break
                end
            end
            if durObj then break end
        end
    end
    if durObj then return durObj.Value, durObj end
    local hooked = getgenv().RealDurability or 0
    if hooked > 0 then return hooked, "hook" end
    return 0, nil
end

local function getPlayerStats()
    local stats = {Str = 0, Dur = 0, Reb = 0, DurSource = nil}
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local str = leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Power")
        local reb = leaderstats:FindFirstChild("Rebirths")
        if str then stats.Str = str.Value end
        if reb then stats.Reb = reb.Value end
    end
    stats.Dur, stats.DurSource = readDurability()
    return stats
end

